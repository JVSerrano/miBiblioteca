rules_version = '2';

// RIESGO ACEPTADO (ver specs/00-base-firebase-googlebooks.md):
// Acceso de lectura/escritura abierto, sin Firebase Auth. Los datos no son
// sensibles (inventario personal de libros). Firebase Auth con credencial
// compartida queda documentado como mejora futura.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
